-- 创建表空间
CREATE TABLESPACE ts_seckey_admin
LOGGING
DATAFILE '/opt/oracle/oradata/FREE/FREEPDB1/ts_seckeymng_admin.dbf' SIZE 50M
EXTENT MANAGEMENT LOCAL;

CREATE TABLESPACE ts_seckey_op
LOGGING
DATAFILE '/opt/oracle/oradata/FREE/FREEPDB1/ts_seckeymng_op.dbf' SIZE 200M
EXTENT MANAGEMENT LOCAL;

-- 修改数据文件以开启自动扩展
ALTER DATABASE DATAFILE '/opt/oracle/oradata/FREE/FREEPDB1/ts_seckeymng_admin.dbf' AUTOEXTEND ON NEXT 50M MAXSIZE UNLIMITED;
ALTER DATABASE DATAFILE '/opt/oracle/oradata/FREE/FREEPDB1/ts_seckeymng_op.dbf' AUTOEXTEND ON NEXT 200M MAXSIZE UNLIMITED;

-- 创建方案（创建用户）
CREATE USER SECMNG PROFILE DEFAULT
IDENTIFIED BY SECMNG DEFAULT TABLESPACE USERS
ACCOUNT UNLOCK;

-- 添加登录权限
GRANT resource TO SECMNG;
GRANT create session TO SECMNG;

-- 创建网点信息表
CREATE TABLE SECMNG.SECNODE(
    id char(4) PRIMARY KEY,
    name VARCHAR2(128) NOT NULL,
    nodedesc VARCHAR2(512),
    createtime date,
    authcode NUMBER(12),
    state NUMBER(4)
) TABLESPACE ts_seckey_admin;

-- 插入网点信息数据
INSERT INTO SECMNG.SECNODE VALUES('0001', '网银中心', '北京金融街23号', TO_DATE('2015-07-15', 'YYYY-MM-DD'), 1, 0);
INSERT INTO SECMNG.SECNODE VALUES('1111', '广东分中心1111', '广州天河金融', TO_DATE('2015-07-15', 'YYYY-MM-DD'), 1111, 0);
COMMIT;

-- 创建网点密钥表
CREATE TABLE SECMNG.SECKEYINFO(
    clientid char(4) constraint secmng_seckeinode_clientid_fk references SECMNG.SECNODE(id),
    serverid char(4) constraint secmng_seckeinode_serverid_fk references SECMNG.SECNODE(id),
    keyid NUMBER(9),
    createtime date,
    state NUMBER(4),
    seckey VARCHAR2(512)
) TABLESPACE ts_seckey_admin;

-- 创建序列号表
CREATE TABLE SECMNG.KEYSN(
    ikeysn number(12) PRIMARY KEY
) TABLESPACE ts_seckey_admin;

INSERT INTO SECMNG.KEYSN(ikeysn) VALUES (1);
COMMIT;

-- 创建服务配置表
CREATE TABLE SECMNG.SRVCFG(
    key VARCHAR2(64),
    valude VARCHAR2(128)
) TABLESPACE ts_seckey_admin;

-- 创建交易信息表
CREATE TABLE SECMNG.TRAN(
    IID Number(12) PRIMARY KEY,
    tran_operator NUMBER,
    trantime date,
    tranid NUMBER(4),
    trandesc VARCHAR2(512)
) TABLESPACE ts_seckey_op;

-- 创建索引
CREATE INDEX SECMNG.IX_TRAN_tran_operator ON SECMNG.TRAN(tran_operator) TABLESPACE ts_seckey_op;

-- 创建序列
CREATE SEQUENCE SECMNG.SEQIID INCREMENT BY 1 START WITH 1
MAXVALUE 1.0E28 MINVALUE 1 NOCYCLE
CACHE 20 NOORDER;

-- 创建触发器
CREATE OR REPLACE TRIGGER SECMNG.SEQIID
BEFORE INSERT ON SECMNG.TRAN
FOR EACH ROW
BEGIN
    SELECT SECMNG.SEQIID.nextval INTO :new.IID FROM dual;
END;
/

